<h1 style="
  position: relative;
  padding: 0.1em 0.5em;
  background: -webkit-linear-gradient(to right, #ff0000, transparent);
  background: linear-gradient(to right, #ff0000, transparent);
  color: #000;">カテゴリ別急上昇ランキング</h1>

<%= form_with url: videos_path, method: :get, local: true do %>
  <label for="category_id" style="
    font-size:16px;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8px;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  ">カテゴリを選択</label>
  <select name="category_id" id="category_id" style="
  width: 25%;
  padding: 5px;
  font-size: 14px;
  border: 1px solid #ccc;
  border-radius: 5px;
  background-color: #f9f9f9;
  color: #333;
  appearance: none;
  -webkit-appearance: none;
  -moz-appearance: none;
  cursor: pointer;
  transition: border-color 0.3s ease;
" onfocus="this.style.borderColor='#4CAF50'" onblur="this.style.borderColor='#ccc'"
>
    <option value="0">すべて</option>
    <option value="1">映画</option>
    <option value="10">音楽</option>
    <option value="17">スポーツ</option>
    <option value="20">ゲーム</option>
    <option value="25">ニュース</option>
    <option value="23">コメディ</option>
    <option value="27">教育</option>
    <option value="28">科学&技術</option>
    <option value="99">VTuber関連</option>
  </select>
<button type="submit" style="
  background-color: #ff0000;
  color: white;
  padding: 10px 10px;
  font-size: 12px;
  font-weight: bold;
  border: none;
  border-radius: 5px;
  cursor: pointer;
  transition: background-color 0.3s ease;
">
  表示
</button>
<% end %>

<ul>
  <% @videos.each do |video| %>
    <li>
      <h3><%= link_to video.title, video.youtube_url, target: "_blank" %></h3>
      <%= link_to image_tag(video.thumbnail_url, alt: "#{video.title}のサムネイル"), video.youtube_url, target: "_blank" %>
      <p>チャンネル: <%= video.channel_name %></p>
      <p>再生回数: <%= video.view_count %>回</p>
      <p>投稿日: <%= video.published_at.strftime("%Y年%m月%d日 %H:%M") if video.published_at.present? %></p>
    </li>
  <% end %>
</ul>

